{
  "info": { "name": "LeadFlow API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "leadId", "value": "" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "item": [
    { "name": "Register", "auth": { "type": "noauth" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().data.token);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/register", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sales User\",\n  \"email\": \"sales@example.com\",\n  \"password\": \"password123\"\n}" } } },
    { "name": "Login", "auth": { "type": "noauth" }, "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().data.token);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"sales@example.com\",\n  \"password\": \"password123\"\n}" } } },
    { "name": "Me", "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } },
    { "name": "Create lead", "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('leadId', pm.response.json().data._id);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/leads", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Deepak Sharma\",\n  \"email\": \"deepak@acme.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"company\": \"Acme Corp\",\n  \"source\": \"LinkedIn\",\n  \"status\": \"New\"\n}" } } },
    { "name": "List leads", "request": { "method": "GET", "url": "{{baseUrl}}/leads?search=deepak&status=New&page=1&limit=10&sortBy=createdAt&order=desc" } },
    { "name": "Lead stats", "request": { "method": "GET", "url": "{{baseUrl}}/leads/stats" } },
    { "name": "Get lead", "request": { "method": "GET", "url": "{{baseUrl}}/leads/{{leadId}}" } },
    { "name": "Update lead", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/leads/{{leadId}}", "body": { "mode": "raw", "raw": "{\n  \"status\": \"Qualified\"\n}" } } },
    { "name": "Delete lead", "request": { "method": "DELETE", "url": "{{baseUrl}}/leads/{{leadId}}" } }
  ]
}
